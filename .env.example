# Copy to .env.local for local development. Never commit real values.

# Optional. Kaizen's own address (https://kaizenstore.cloud). Without it, the
# project's production domain, but never the store domain (src/lib/site.ts).
SITE_URL=

# Where stores live (P7): each at {store}.{this domain}, a domain of their own,
# separate from Kaizen's. Read at build time. Leave empty to serve stores at
# /s/{store} on Kaizen's own host; `localhost:3000` tries hosts locally
# (demo.localhost:3000). Set in Vercel for Production only.
NEXT_PUBLIC_STORE_DOMAIN=
# The theme store on its own host (docs/theme-phase-3.md step 3), such as themes.kaizenaflow.com; empty keeps it at /themes.
NEXT_PUBLIC_THEMES_HOST=
# The docs portal on its own host (D442), such as docs.kaizenaflow.com; empty keeps it at /docs (and /no/docs). Read at build time;
# set it only once the DNS record and the Vercel domain are in place (docs/wave-14-developer-platform.md E1).
NEXT_PUBLIC_DOCS_HOST=

# Server only. Stores' own domains (P8): a Vercel access token for the team,
# the project and team ids, and a deploy hook on main (Project Settings → Git
# → Deploy Hooks), used to deploy again when domains change. Without them,
# owners cannot add domains. Secret: the token and the hook.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_DEPLOY_HOOK_URL=

# Supabase project "Kaizen Store" (eu-west-1). Both are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://ybsozesfuxuitoacntfo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Supabase → Connect → Transaction pooler (port 6543). Secret.
DATABASE_URL=

# Server only. Encrypts payment credentials stored in the database. Generate
# with `openssl rand -base64 32` and keep a copy: without it, saved keys cannot
# be read back. Secret.
SETTINGS_ENCRYPTION_KEY=

# Server only, set only while the settings key is being rotated (docs/runbooks/key-rotation.md): the old value of
# SETTINGS_ENCRYPTION_KEY, read but never written with, until every secret is under the new one. Secret.
SETTINGS_ENCRYPTION_KEY_PREVIOUS=

# Server only. The keys gift card and recovery codes are hashed under, so a new settings key changes neither.
# Unset, both are made from SETTINGS_ENCRYPTION_KEY; `node scripts/hash-keys.mjs` prints those values to set here. Secret.
GIFT_CARD_HASH_KEY=
RECOVERY_CODE_HASH_KEY=

# Server only. Supabase → Project Settings → API Keys → Secret key (sb_secret_…).
# Lets the admin upload product pictures to Storage. Without it, the product
# editor asks for picture addresses instead. Secret.
SUPABASE_SECRET_KEY=

# Server only. Resend sends shoppers' emails (D26, D32). Without the key and
# EMAIL_FROM, emails are only recorded in the admin's email log. The key is a
# sending-access key (re_…); EMAIL_FROM is an address on the domain verified in
# Resend. The webhook secret (whsec_…) checks Resend's delivery events sent to
# /api/resend/webhook. Secret: the key and the webhook secret.
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

# Server only. Vercel Cron sends it to the daily subscription reminder job
# (D29). Generate with `openssl rand -base64 32`. Without it, no reminders go
# out. Secret.
CRON_SECRET=

# Sign in with Kaizen Life (D95): set to "on" once both Supabase projects have the OAuth server
# on, each other registered as clients, and the custom:kaizen-life provider set up.
KAIZEN_LIFE_SSO=

# Kaizen Life's address (default https://kaizenalife.com). The assistants work together over the
# account link below (D517, D519); D96's OAuth connection and its KAIZEN_LIFE_CLIENT_ID,
# KAIZEN_LIFE_ISSUER and KAIZEN_LIFE_OAUTH_* settings are retired (D525).
KAIZEN_LIFE_URL=

# Kaizen Life's account link (docs/life-work-summary.md 3.3): Kaizena Flow's own ES256 private key (PKCS#8 PEM, made with
# `openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt`), which signs what it asks Kaizen Life, and
# Kaizen Life's public key (SPKI PEM), which checks what Kaizen Life asks here. `\n` may stand for each line break. Both set,
# accounts on both apps are linked by themselves and Kaizen Life can read a linked account's Work summary; without them, nothing
# is linked and /api/kaizen-life refuses everything. The private key is a secret.
KAIZEN_LIFE_LINK_PRIVATE_KEY=
KAIZEN_LIFE_LINK_PUBLIC_KEY=

# Slack (D101): Kaizen's own Slack app, with only the incoming-webhook scope and the redirect URL
# {SITE_URL}/api/integrations/slack/callback. Both set, owners connect Slack with "Add to Slack";
# without them, they paste an incoming webhook they made themselves.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Server only. Kaizena Flow's Instagram app (D559): "Instagram API with Instagram Login", permission
# instagram_business_basic only, redirect URL {SITE_URL}/api/integrations/instagram/callback. Both set,
# owners connect their Instagram professional account for the Instagram feed component; without them
# the Instagram page says it cannot be connected yet and feeds show nothing.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Server only. Kaizena Flow's Mollie app (wave 4 unit E, D292), with its redirect URL set to
# {SITE_URL}/api/integrations/mollie/callback. Both set (and SETTINGS_ENCRYPTION_KEY), owners can connect their own
# Mollie account on the Payments page and take payments through Mollie; without them, Mollie is not offered.
MOLLIE_CLIENT_ID=
MOLLIE_CLIENT_SECRET=

# Server only. Kaizena Flow's own Google OAuth client for customers' Sign in with Google (wave 10 unit L, D375), made in
# Google Cloud's console as a Web application with {SITE_URL}/api/auth/google/callback as its one redirect URL and only the
# email scope. Both set (and SETTINGS_ENCRYPTION_KEY), every store whose accounts are on offers it on its sign-in form;
# without them, nothing shows.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server only. Kaizena Flow's own Shopify app for moving a shop in (D445 step 2, shopify/shopify.app.toml), made in Shopify's
# Dev Dashboard with {SITE_URL}/api/shopify/callback as its redirect URL. Both set (and SETTINGS_ENCRYPTION_KEY), Settings ->
# Moving in offers Connect Shopify; without them, the file imports alone. SHOPIFY_ALL_ORDERS=1 once Shopify has approved
# read_all_orders for the app.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ALL_ORDERS=

# Server only. Fiken (D460): Kaizena Flow's OAuth2 app at Fiken (Fiken → your user → API → Apps; redirect https://kaizenaflow.com/api/integrations/fiken/callback).
# Without them the Fiken page says it is not available yet. Fiken allows 5 users until it grants production status (api@fiken.no).
FIKEN_CLIENT_ID=
FIKEN_CLIENT_SECRET=
# eBay as a sales channel (D555): Kaizena Flow's app at developer.ebay.com, and the RuName of its return address {SITE_URL}/api/integrations/ebay/callback.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=

# Server only. Kaizena Flow's consumer tokens from Tripletex (D453, docs/tripletex.md): given by Tripletex when it approves the
# integration "Kaizena Flow", one for its test environment and one for production. With one set, an owner may paste an employee token
# made for Kaizena Flow; without, only a company's own API token (Company -> API tokens) connects.
TRIPLETEX_CONSUMER_TOKEN=
TRIPLETEX_TEST_CONSUMER_TOKEN=

# Sendcloud labels (D483, docs/sendcloud-labels.md): Kaizena Flow's Tech Partner id (a UUID from Sendcloud), sent with every call
# once Sendcloud has approved the integration. Leave empty until then: Sendcloud refuses an id it does not know. Each shop's own
# Sendcloud keys are saved under Integrations, never here.
SENDCLOUD_PARTNER_ID=

# Server only. Two-step sign-in for staff (wave 1, 1f) is on unless this is "off": the break-glass if Supabase's
# multi-factor sign-in is misconfigured and nobody can reach the admin. It lifts the requirement for everyone, is
# written to the audit log at the next sign-in, and should be removed again as soon as the cause is fixed.
ADMIN_TWO_STEP=

# Server only. Kaizena Flow's own Stripe account, the Connect platform every store's payments go through (D15: a store's own payment
# settings are kept in the admin, never here). One pair per mode; without a mode's pair, that mode's payments are not offered.
STRIPE_SECRET_KEY_TEST=
STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_PUBLISHABLE_KEY_LIVE=

# Server only. A read replica for heavy reads that may lag a moment (D314, docs/capacity.md step 3.4); without it they read DATABASE_URL.
READ_DATABASE_URL=

# Server only. Push notifications for the installable admin (D361): a VAPID key pair (`npx web-push generate-vapid-keys`) and the
# contact the push services see (an https: or mailto: address; https://kaizenaflow.com when empty). Without the keys, push is not offered.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Server only. Vercel's log drain for usage (D314, docs/capacity.md step 1.4): the secret it signs with, and the sampling rate it was
# made with (1 when empty, at most 1). Without the secret, /api/usage/drain is off.
USAGE_DRAIN_SECRET=
USAGE_DRAIN_SAMPLE_RATE=

# Server only. Domain Connect's signing key (D315 6): the private key in PEM (PKCS#8 or RSA), `\n` allowed for line breaks. Without it,
# "Connect automatically" is not offered for a store's domain.
DOMAIN_CONNECT_PRIVATE_KEY=

# Server only. The domain Resend receives support email for (D332, docs/support.md step 16); without it, email into the support desk is off.
SUPPORT_INBOUND_DOMAIN=

# Local development only, ignored on Vercel: "1" lets the page replicator fetch addresses on a private network (REPLICATE_ALLOW_PRIVATE),
# and VIES_TEST_URL with VIES_ALLOW_TEST_URL=1 points the VAT-number check at a stand-in (e2e/fixtures/vies-stub.mjs).
REPLICATE_ALLOW_PRIVATE=
VIES_TEST_URL=
VIES_ALLOW_TEST_URL=
