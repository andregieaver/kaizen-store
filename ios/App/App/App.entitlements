<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- An email's sign-in link (/auth/confirm) opens the app (Universal Links, D908), checked against the site's
	     /.well-known/apple-app-site-association. Needs the Associated Domains capability on the App ID. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:kaizenaflow.com</string>
	</array>
</dict>
</plist>
