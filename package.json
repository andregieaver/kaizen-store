{
  "name": "kaizen-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=7168 next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "perf": "node scripts/perf.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:template": "node scripts/db-template.mjs",
    "db:clone": "node scripts/db-template.mjs clone",
    "db:check": "drizzle-kit check && drizzle-kit generate && git diff --exit-code -- supabase && test -z \"$(git ls-files --others --exclude-standard -- supabase)\"",
    "test:int": "vitest run --config vitest.integration.config.mts",
    "parity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/parity.mjs",
    "parity:write": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/parity.mjs write",
    "parity:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/parity.mjs check"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@google/model-viewer": "4.3.1",
    "@jsquash/avif": "2.1.1",
    "@sparticuz/chromium": "153.0.0",
    "@stripe/connect-js": "3.4.6",
    "@stripe/react-connect-js": "3.4.4",
    "@stripe/react-stripe-js": "6.12.0",
    "@stripe/stripe-js": "9.17.0",
    "@supabase/realtime-js": "2.117.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "@tiptap/core": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@vercel/functions": "3.9.9",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.48.0",
    "mammoth": "1.13.0",
    "mediabunny": "1.61.4",
    "motion": "^13.4.6",
    "next": "16.4.2",
    "opentype.js": "1.3.4",
    "pg": "8.23.0",
    "playwright-core": "1.63.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "seek-bzip": "2.0.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "simple-icons": "^16.33.0",
    "stripe": "22.6.2",
    "three": "0.183.2",
    "unpdf": "1.8.1",
    "web-push": "3.6.7",
    "web-vitals": "5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/opentype.js": "1.3.8",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
