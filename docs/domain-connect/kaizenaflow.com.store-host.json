{
  "providerId": "kaizenaflow.com",
  "providerName": "Kaizena Flow",
  "serviceId": "store-host",
  "serviceName": "Online store on a subdomain",
  "version": 1,
  "logoUrl": "https://kaizenaflow.com/kaizen/favicon.ico",
  "description": "Connects the domain to a Kaizena Flow online store: points it at the store and adds the record that shows it is yours.",
  "variableDescription": "token: the store's proof for this name.",
  "syncBlock": false,
  "syncPubKeyDomain": "kaizenaflow.com",
  "syncRedirectDomain": "kaizenaflow.com",
  "warnPhishing": true,
  "hostRequired": true,
  "records": [
    {
      "type": "CNAME",
      "host": "@",
      "pointsTo": "cname.vercel-dns.com",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "_kaizen",
      "data": "kaizen-verify=%token%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    }
  ]
}
